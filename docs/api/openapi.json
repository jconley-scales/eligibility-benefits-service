{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Eligibility & Benefits API",
    "description" : "Answers an Eligibility check for one Member, one Procedure, and one Service date: is the Member's coverage active, what is their Plan's Benefit for the procedure, does it need prior authorization, and what is their cost share. Every Member and Plan is synthetic. The service runs locally and has no authentication.",
    "license" : {
      "name" : "MIT",
      "url" : "https://github.com/jconley-scales/eligibility-benefits-service/blob/main/LICENSE"
    },
    "version" : "v1"
  },
  "externalDocs" : {
    "description" : "Source, glossary, and design decisions",
    "url" : "https://github.com/jconley-scales/eligibility-benefits-service"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local: docker compose up"
  } ],
  "paths" : {
    "/v1/plans/{planId}/benefits" : {
      "get" : {
        "tags" : [ "Plans" ],
        "summary" : "List a Plan's Benefits",
        "description" : "The Plan's details and its Benefits, ordered by procedure code: which procedures the Plan pays for, and on what terms.",
        "operationId" : "getPlanBenefits",
        "parameters" : [ {
          "name" : "planId",
          "in" : "path",
          "description" : "The Plan's ID.",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "HMO-STANDARD"
        } ],
        "responses" : {
          "200" : {
            "description" : "The Plan and its Benefits.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlanBenefitsResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No Plan has this ID.",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/members/{memberId}/coverage" : {
      "get" : {
        "tags" : [ "Members" ],
        "summary" : "List a Member's coverage history",
        "description" : "The Member's Coverages, each with its Plan, ordered by start date.",
        "operationId" : "getMemberCoverage",
        "parameters" : [ {
          "name" : "memberId",
          "in" : "path",
          "description" : "The Member's ID.",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "SYN-0007"
        } ],
        "responses" : {
          "200" : {
            "description" : "The Member's coverage history.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberCoverageResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "No Member has this ID.",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProblemDetails" : {
        "type" : "object",
        "description" : "An error, in the RFC 9457 Problem Details format.",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri-reference",
            "description" : "Identifies the problem type. Left out when it is about:blank, meaning the HTTP status says it all."
          },
          "title" : {
            "type" : "string",
            "description" : "A short summary of the problem type, such as \"Not Found\"."
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The HTTP status code."
          },
          "detail" : {
            "type" : "string",
            "description" : "What went wrong with this request."
          },
          "instance" : {
            "type" : "string",
            "format" : "uri-reference",
            "description" : "The path of the request that failed."
          }
        }
      },
      "BenefitSummary" : {
        "type" : "object",
        "description" : "A Plan's Benefit for one procedure. When covered is false the Plan excludes the procedure, and the terms (priorAuthRequired, deductibleApplies, copay, coinsurancePercent) are null.",
        "properties" : {
          "procedureCode" : {
            "type" : "string",
            "description" : "A CPT or HCPCS code."
          },
          "covered" : {
            "type" : "boolean",
            "description" : "Whether the Plan pays for the procedure."
          },
          "priorAuthRequired" : {
            "type" : [ "boolean", "null" ],
            "description" : "Whether prior authorization is required before the procedure."
          },
          "deductibleApplies" : {
            "type" : [ "boolean", "null" ],
            "description" : "Whether the deductible applies to the procedure."
          },
          "copay" : {
            "type" : [ "number", "null" ],
            "description" : "The copay in dollars, with two decimals."
          },
          "coinsurancePercent" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "description" : "The coinsurance, as a whole-number percentage.",
            "maximum" : 100,
            "minimum" : 0
          }
        }
      },
      "PlanBenefitsResponse" : {
        "type" : "object",
        "properties" : {
          "planId" : {
            "type" : "string"
          },
          "planName" : {
            "type" : "string"
          },
          "planType" : {
            "type" : "string",
            "enum" : [ "HMO", "PPO" ]
          },
          "deductible" : {
            "type" : "number",
            "description" : "In dollars, with two decimals."
          },
          "outOfPocketMaximum" : {
            "type" : "number",
            "description" : "In dollars, with two decimals."
          },
          "benefits" : {
            "type" : "array",
            "description" : "One Benefit per procedure code. A procedure that isn't listed has no benefit on file under this Plan, which means unknown, not unpaid.",
            "items" : {
              "$ref" : "#/components/schemas/BenefitSummary"
            }
          }
        }
      },
      "CoverageSummary" : {
        "type" : "object",
        "properties" : {
          "planId" : {
            "type" : "string"
          },
          "planName" : {
            "type" : "string"
          },
          "planType" : {
            "type" : "string",
            "enum" : [ "HMO", "PPO" ]
          },
          "startDate" : {
            "type" : "string",
            "format" : "date"
          },
          "endDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          }
        }
      },
      "MemberCoverageResponse" : {
        "type" : "object",
        "properties" : {
          "memberId" : {
            "type" : "string"
          },
          "coverages" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CoverageSummary"
            }
          }
        }
      }
    }
  }
}
